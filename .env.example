# Public site URL used for canonical tags, sitemap and structured data.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL if unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com.au

# ---- Lead delivery (configure at least one before launch) ----
# Resend (https://resend.com) – emails each quote request to you and a confirmation to the customer.
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Swept <quotes@yourdomain.com.au>"
LEAD_FROM_EMAIL=
# Optional: POST every lead as JSON to a webhook (Zapier, Make, HubSpot, Google Sheets, etc.)
LEAD_WEBHOOK_URL=

# ---- Analytics (optional; set one) ----
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
